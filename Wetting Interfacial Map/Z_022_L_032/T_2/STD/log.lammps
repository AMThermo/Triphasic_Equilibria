LAMMPS (2 Aug 2023 - Update 1)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task
package gpu 1
read_restart rst.out
Reading restart file ...
  restart file = 2 Aug 2023, LAMMPS = 2 Aug 2023
  restoring atom style full from restart
  orthogonal box = (0 0 0) to (48 48 480)
  1 by 1 by 1 MPI processor grid
  restoring pair style mie/cut/gpu from restart
  10350 atoms
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     0 = max # of 1-2 neighbors
     0 = max # of 1-3 neighbors
     0 = max # of 1-4 neighbors
     1 = max # of special neighbors
  special bonds CPU = 0.001 seconds
  read_restart CPU = 0.003 seconds


variable eps11 equal 0.2941

#INPUT lambda(lam), zeta y la temperatura

variable zeta equal 0.22
variable lam equal 0.335
variable TT equal 181.1647

#internal operation
variable eps22 equal (${zeta}*${eps11}+${eps11})/(1-${zeta})
variable eps22 equal (0.22*${eps11}+${eps11})/(1-${zeta})
variable eps22 equal (0.22*0.2941+${eps11})/(1-${zeta})
variable eps22 equal (0.22*0.2941+0.2941)/(1-${zeta})
variable eps22 equal (0.22*0.2941+0.2941)/(1-0.22)
variable eps12 equal (${eps11}+${eps22}-${lam}*${eps11}-${lam}*${eps22})/2
variable eps12 equal (0.2941+${eps22}-${lam}*${eps11}-${lam}*${eps22})/2
variable eps12 equal (0.2941+0.460002564102564-${lam}*${eps11}-${lam}*${eps22})/2
variable eps12 equal (0.2941+0.460002564102564-0.335*${eps11}-${lam}*${eps22})/2
variable eps12 equal (0.2941+0.460002564102564-0.335*0.2941-${lam}*${eps22})/2
variable eps12 equal (0.2941+0.460002564102564-0.335*0.2941-0.335*${eps22})/2
variable eps12 equal (0.2941+0.460002564102564-0.335*0.2941-0.335*0.460002564102564)/2



#crear grupos con tipos de átomos
group c1 type 1
4456 atoms in group c1
group c2 type 2
5894 atoms in group c2

#---------------------------------------- Force Field ---------------------------------------
#--------------------------------------------------------------------------------------------
pair_style	mie/cut		22.5
#--------------------------------------------------------------------------------------------
  #Mie Coeff    i j     eps(Kcal/mol)    s (Å)    Lr       La      # mie/cut
  pair_coeff	1 1     ${eps11}          3.73     12    6
  pair_coeff	1 1     0.2941          3.73     12    6
  pair_coeff	2 2     ${eps22}          3.73     12    6
  pair_coeff	2 2     0.460002564102564          3.73     12    6
  pair_coeff	1 2     ${eps12}          3.73     12    6
  pair_coeff	1 2     0.250739102564103          3.73     12    6


#--------------------------------------------------------------------------------------------
pair_modify	tail	no

#------------------------------------ Output Settings ---------------------------------------
# Printing statistics and frequencies
#--------------------------------------------------------------------------------------------

thermo 		1000
	thermo_style 	custom	step cpu temp press density etotal ke pe evdwl etail
dump 	1	all 	xyz 	100000 	lammpstrj.xyz   # coordinates file XYZ every 10000 steps
restart		20000000	rst

#-------------------------------------------- Run -------------------------------------------
#--------------------------------------------------------------------------------------------


timestep	4

variable      	TotEng  equal etotal
fix averages	all     ave/time 20 5000 100000 c_thermo_temp c_thermo_press[0] c_thermo_press[1] c_thermo_press[2] c_thermo_press[3] v_TotEng  file ave.lammps.txt

# Select NVT simulation

fix   	TP	all	nvt	temp 	${TT} ${TT} 100
fix   	TP	all	nvt	temp 	181.1647 ${TT} 100
fix   	TP	all	nvt	temp 	181.1647 181.1647 100

compute lala all chunk/atom bin/1d z lower 1 units box

#calculo de los tensores
compute T all temp
compute press all stress/atom T
fix tensor1 all ave/chunk  20 125000 2500000 lala density/number c_press[1] c_press[2] c_press[3] file tensores.txt

fix tensor2 c1 ave/chunk  20 125000 2500000 lala density/number file c1.txt
fix tensor3 c2 ave/chunk  20 125000 2500000 lala density/number file c2.txt

fix 1 all recenter NULL NULL INIT
  run 25000000

