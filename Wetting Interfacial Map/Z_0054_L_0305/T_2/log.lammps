LAMMPS (2 Aug 2023 - Update 1)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task
package gpu 1
#---------------------------------- Simulation Settings -------------------------------------
#--------------------------------------------------------------------------------------------
units		real    # r(Å), t(fs), E(Kcal/mol), T(K), P(atm)
boundary 	p p p	# PBCs in 3 directions
dimension 	3	# 3D simulation
atom_style  	full	# Molecular representation

#---------------------------------- Simulation Settings -------------------------------------
# Here we define the lattice, create the system and load the masses/charges of each atom.
#--------------------------------------------------------------------------------------------

variable eps11 equal 0.2941

#INPUT lambda(lam), zeta y la temperatura

variable zeta equal 0.054
variable lam equal 0.305
variable TT equal 148.4932

#internal operation
variable eps22 equal (${zeta}*${eps11}+${eps11})/(1-${zeta})
variable eps22 equal (0.054*${eps11}+${eps11})/(1-${zeta})
variable eps22 equal (0.054*0.2941+${eps11})/(1-${zeta})
variable eps22 equal (0.054*0.2941+0.2941)/(1-${zeta})
variable eps22 equal (0.054*0.2941+0.2941)/(1-0.054)
variable eps12 equal (${eps11}+${eps22}-${lam}*${eps11}-${lam}*${eps22})/2
variable eps12 equal (0.2941+${eps22}-${lam}*${eps11}-${lam}*${eps22})/2
variable eps12 equal (0.2941+0.327675898520085-${lam}*${eps11}-${lam}*${eps22})/2
variable eps12 equal (0.2941+0.327675898520085-0.305*${eps11}-${lam}*${eps22})/2
variable eps12 equal (0.2941+0.327675898520085-0.305*0.2941-${lam}*${eps22})/2
variable eps12 equal (0.2941+0.327675898520085-0.305*0.2941-0.305*${eps22})/2
variable eps12 equal (0.2941+0.327675898520085-0.305*0.2941-0.305*0.327675898520085)/2


lattice custom 1 a1 48 0. 0. a2 0. 48  0. a3 0. 0. 624  basis 0. 0. 0.
Lattice spacing in x,y,z = 48 48 624
region ELLV block 0 1 0 1 0 1 units lattice
create_box 2 ELLV
Created orthogonal box = (0 0 0) to (48 48 624)
  1 by 1 by 1 MPI processor grid

region L1 block 0 1 0 1 0 0.3333 units lattice
region L2 block 0 1 0 1 0.3333 0.6666 units lattice
region V block 0 1 0 1 0.6666 1 units lattice

create_atoms 1 random 5988 6000 L1
Created 5988 atoms
  using lattice units in orthogonal box = (0 0 0) to (48 48 624)
  create_atoms CPU = 0.001 seconds
create_atoms 2 random 367 600 L1
Created 367 atoms
  using lattice units in orthogonal box = (0 0 0) to (48 48 624)
  create_atoms CPU = 0.000 seconds
create_atoms 1 random 290 1400 L2
Created 290 atoms
  using lattice units in orthogonal box = (0 0 0) to (48 48 624)
  create_atoms CPU = 0.000 seconds
create_atoms 2 random 6590 6500 L2
Created 6590 atoms
  using lattice units in orthogonal box = (0 0 0) to (48 48 624)
  create_atoms CPU = 0.000 seconds
create_atoms 1 random 315 400 V
Created 315 atoms
  using lattice units in orthogonal box = (0 0 0) to (48 48 624)
  create_atoms CPU = 0.000 seconds
create_atoms 2 random 172 230 V
Created 172 atoms
  using lattice units in orthogonal box = (0 0 0) to (48 48 624)
  create_atoms CPU = 0.000 seconds

#       i       g/mol
mass	1	16
mass    2       16

#crear grupos con tipos de átomos
group c1 type 1
6593 atoms in group c1
group c2 type 2
7129 atoms in group c2

#---------------------------------------- Force Field ---------------------------------------
#--------------------------------------------------------------------------------------------
pair_style	mie/cut		22.5
#--------------------------------------------------------------------------------------------
  #Mie Coeff    i j     eps(Kcal/mol)    s (Å)    Lr       La      # mie/cut
  pair_coeff	1 1     ${eps11}          3.73     12    6
  pair_coeff	1 1     0.2941          3.73     12    6
  pair_coeff	2 2     ${eps22}          3.73     12    6
  pair_coeff	2 2     0.327675898520085          3.73     12    6
  pair_coeff	1 2     ${eps12}          3.73     12    6
  pair_coeff	1 2     0.21606712473573          3.73     12    6


#--------------------------------------------------------------------------------------------
pair_modify	tail	no

#------------------------------------ Output Settings ---------------------------------------
# Printing statistics and frequencies
#--------------------------------------------------------------------------------------------

thermo 		1000
	thermo_style 	custom	step cpu temp press density etotal ke pe evdwl etail
dump 	1	all 	xyz 	100000 	lammpstrj.xyz   # coordinates file XYZ every 10000 steps
restart		20000000	rst

#-------------------------------------------- Run -------------------------------------------
#--------------------------------------------------------------------------------------------

# 		Etol	      Ftol	   Maxiter	Maxeval
minimize 	1.0e-4 	     1.0e-6 	    1000       10000

