#---------------------------------- Simulation Settings -------------------------------------
# Some definitions on how the simulations are performed (probably always untouched).
#--------------------------------------------------------------------------------------------
units		real    # r(Å), t(fs), E(Kcal/mol), T(K), P(atm)
boundary 	p p p	# PBCs in 3 directions
dimension 	3	# 3D simulation
atom_style  	full	# Molecular representation

#---------------------------------- Simulation Settings -------------------------------------
# Here we define the lattice, create the system and load the masses/charges of each atom.
#--------------------------------------------------------------------------------------------


# Crea las coordenadas geométricas y el box
lattice custom 1 a1 48 0. 0. a2 0. 48  0. a3 0. 0. 624  basis 0. 0. 0.   
region ELV block 0 1 0 1 0 1 units lattice 
create_box 2 ELV 
#Crea las 3 regiones L1-L2-V

region L1 block 0 1 0 1 0 0.3333 units lattice
region L2 block 0 1 0 1 0.3333 0.6666 units lattice  
region V block 0 1 0 1 0.6666 1 units lattice 


create_atoms 1 random 5857 6500 L1
create_atoms 2 random 1225 1500 L1
create_atoms 1 random 1061 1500 L2
create_atoms 2 random 6496 6800 L2
create_atoms 1 random 88 400 V
create_atoms 2 random 20 30 V

# Declaro pesos moleculares
#       i       g/mol
mass	1	16
mass    2       16

#crear grupos con tipos de átomos
group c1 type 1
group c2 type 2

#---------------------------------------- Force Field ---------------------------------------
# here the information about the interactions and force field parameters are compiled
#--------------------------------------------------------------------------------------------
pair_style	mie/cut		22.5
#--------------------------------------------------------------------------------------------
  #Mie Coeff    i j     eps(Kcal/mol)    s (Å)    Lr       La      # mie/cut
  pair_coeff	1 1     0.2941           3.73     12    6
  pair_coeff	2 2     0.3595           3.73     12    6
  pair_coeff	1 2     0.2745          3.73     12    6
 

#--------------------------------------------------------------------------------------------
pair_modify	tail	no

#------------------------------------ Output Settings ---------------------------------------
# Printing statistics and frequencies
#--------------------------------------------------------------------------------------------

# print the thermodynamic output every 1000 time steps and print the following info 
thermo 		1000					
	thermo_style 	custom	step cpu temp press density etotal ke pe evdwl etail 

dump 	1	all 	xyz 	100000 	lammpstrj.xyz   # coordinates file XYZ every 1000 steps

restart		20000000	rst				# print lammps_restart evert 100000 steps

#-------------------------------------------- Run -------------------------------------------
# Chain of Simulations to get data. (1) minimization, (2) NVT run, (3) NVE run, (4) ...
#--------------------------------------------------------------------------------------------

# (1) Minimization to reduce random creation repulsion
# 		Etol	      Ftol	   Maxiter	Maxeval
minimize 	1.0e-4 	     1.0e-6 	    1000       10000


# (2) default simulation at 4 fs timestep 
timestep	4	

variable      	TotEng  equal etotal
fix averages	all     ave/time 20 5000 100000 c_thermo_temp c_thermo_press[0] c_thermo_press[1] c_thermo_press[2] c_thermo_press[3] v_TotEng  file ave.lammps.txt      

# Select either NVE, NVT or NPT simulation
#fix   	TP	all	nve
fix   	TP	all	nvt	temp 	127.2146 127.2146  100 
#fix   	TP	all	npt	temp 	105  105  100 iso 0.5564 0.5564 1000 


compute lala all chunk/atom bin/1d z lower 1 units box

#calculo de los tensores
compute T all temp
compute press all stress/atom T
fix tensor1 all ave/chunk  20 1000000 20000000 lala density/number c_press[1] c_press[2] c_press[3] file tensoresBFCG4.txt

fix tensor2 c1 ave/chunk 20 1000000 20000000 lala density/number file c1-BFCG4.txt
fix tensor3 c2 ave/chunk  20 1000000 20000000 lala density/number file c2-BFCG4.txt

fix 1 all recenter NULL NULL INIT

  run 160000000 upto
unfix 	TP


#write_data	data.out
write_restart	rst.out

