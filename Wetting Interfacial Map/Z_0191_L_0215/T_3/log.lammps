LAMMPS (2 Aug 2023 - Update 1)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task
package gpu 1
#---------------------------------- Simulation Settings -------------------------------------
#--------------------------------------------------------------------------------------------
units		real    # r(Å), t(fs), E(Kcal/mol), T(K), P(atm)
boundary 	p p p	# PBCs in 3 directions
dimension 	3	# 3D simulation
atom_style  	full	# Molecular representation

#---------------------------------- Simulation Settings -------------------------------------
# Here we define the lattice, create the system and load the masses/charges of each atom.
#--------------------------------------------------------------------------------------------

variable eps11 equal 0.2941

#INPUT lambda(lam), zeta y la temperatura

variable zeta equal 0.191
variable lam equal 0.215
variable TT equal 173.012

#internal operation
variable eps22 equal (${zeta}*${eps11}+${eps11})/(1-${zeta})
variable eps22 equal (0.191*${eps11}+${eps11})/(1-${zeta})
variable eps22 equal (0.191*0.2941+${eps11})/(1-${zeta})
variable eps22 equal (0.191*0.2941+0.2941)/(1-${zeta})
variable eps22 equal (0.191*0.2941+0.2941)/(1-0.191)
variable eps12 equal (${eps11}+${eps22}-${lam}*${eps11}-${lam}*${eps22})/2
variable eps12 equal (0.2941+${eps22}-${lam}*${eps11}-${lam}*${eps22})/2
variable eps12 equal (0.2941+0.432970457354759-${lam}*${eps11}-${lam}*${eps22})/2
variable eps12 equal (0.2941+0.432970457354759-0.215*${eps11}-${lam}*${eps22})/2
variable eps12 equal (0.2941+0.432970457354759-0.215*0.2941-${lam}*${eps22})/2
variable eps12 equal (0.2941+0.432970457354759-0.215*0.2941-0.215*${eps22})/2
variable eps12 equal (0.2941+0.432970457354759-0.215*0.2941-0.215*0.432970457354759)/2


lattice custom 1 a1 48 0. 0. a2 0. 48  0. a3 0. 0. 480  basis 0. 0. 0.
Lattice spacing in x,y,z = 48 48 480
region ELLV block 0 1 0 1 0 1 units lattice
create_box 2 ELLV
Created orthogonal box = (0 0 0) to (48 48 480)
  1 by 1 by 1 MPI processor grid

region L1 block 0 1 0 1 0 0.3333 units lattice
region L2 block 0 1 0 1 0.3333 0.6666 units lattice
region V block 0 1 0 1 0.6666 1 units lattice

create_atoms 1 random 3527 6000 L1
Created 3527 atoms
  using lattice units in orthogonal box = (0 0 0) to (48 48 480)
  create_atoms CPU = 0.001 seconds
create_atoms 2 random 718 400 L1
Created 718 atoms
  using lattice units in orthogonal box = (0 0 0) to (48 48 480)
  create_atoms CPU = 0.000 seconds
create_atoms 1 random 515 600 L2
Created 515 atoms
  using lattice units in orthogonal box = (0 0 0) to (48 48 480)
  create_atoms CPU = 0.000 seconds
create_atoms 2 random 5050 6500 L2
Created 5050 atoms
  using lattice units in orthogonal box = (0 0 0) to (48 48 480)
  create_atoms CPU = 0.000 seconds
create_atoms 1 random 513 400 V
Created 513 atoms
  using lattice units in orthogonal box = (0 0 0) to (48 48 480)
  create_atoms CPU = 0.000 seconds
create_atoms 2 random 72 40 V
Created 72 atoms
  using lattice units in orthogonal box = (0 0 0) to (48 48 480)
  create_atoms CPU = 0.000 seconds

#       i       g/mol
mass	1	16
mass    2       16

#crear grupos con tipos de átomos
group c1 type 1
4555 atoms in group c1
group c2 type 2
5840 atoms in group c2

#---------------------------------------- Force Field ---------------------------------------
#--------------------------------------------------------------------------------------------
pair_style	mie/cut		22.5
#--------------------------------------------------------------------------------------------
  #Mie Coeff    i j     eps(Kcal/mol)    s (Å)    Lr       La      # mie/cut
  pair_coeff	1 1     ${eps11}          3.73     12    6
  pair_coeff	1 1     0.2941          3.73     12    6
  pair_coeff	2 2     ${eps22}          3.73     12    6
  pair_coeff	2 2     0.432970457354759          3.73     12    6
  pair_coeff	1 2     ${eps12}          3.73     12    6
  pair_coeff	1 2     0.285375154511743          3.73     12    6


#--------------------------------------------------------------------------------------------
pair_modify	tail	no

#------------------------------------ Output Settings ---------------------------------------
# Printing statistics and frequencies
#--------------------------------------------------------------------------------------------

thermo 		1000
	thermo_style 	custom	step cpu temp press density etotal ke pe evdwl etail
dump 	1	all 	xyz 	100000 	lammpstrj.xyz   # coordinates file XYZ every 10000 steps
restart		20000000	rst

#-------------------------------------------- Run -------------------------------------------
#--------------------------------------------------------------------------------------------

# 		Etol	      Ftol	   Maxiter	Maxeval
minimize 	1.0e-4 	     1.0e-6 	    1000       10000

