# (2) default simulation at 4 fs timestep
timestep	4

variable      	TotEng  equal etotal
fix averages	all     ave/time 20 50000 1000000 c_thermo_temp c_thermo_press[0] c_thermo_press[1] c_thermo_press[2] c_thermo_press[3] v_TotEng  file ave.lammps.txt

# Select either NVE, NVT or NPT simulation

fix   	TP	all	nvt	temp  117.2575 117.2575 100

compute lala all chunk/atom bin/1d z lower 1 units box

#calculo de los tensores
compute T all temp
compute press all stress/atom T
fix tensor1 all ave/chunk 20 500000 10000000 lala density/number c_press[1] c_press[2] c_press[3] file tensoresA21.txt

fix tensor2 c1 ave/chunk 20 500000 10000000 lala density/number file c1-AI2.txt
fix tensor3 c2 ave/chunk 20 500000 10000000 lala density/number file c2-AI2.txt


fix 1 all recenter NULL NULL INIT
  run 50000000
