read_restart rst.out


variable eps11 equal 0.2941 

#INPUT lambda(lam), zeta y la temperatura

variable zeta equal 0.3
variable lam equal 0.4125
variable TT equal 186.0969

#internal operation
variable eps22 equal (${zeta}*${eps11}+${eps11})/(1-${zeta})
variable eps12 equal (${eps11}+${eps22}-${lam}*${eps11}-${lam}*${eps22})/2



#crear grupos con tipos de átomos
group c1 type 1
group c2 type 2

#---------------------------------------- Force Field ---------------------------------------
#--------------------------------------------------------------------------------------------
pair_style	mie/cut		22.5
#--------------------------------------------------------------------------------------------
  #Mie Coeff    i j     eps(Kcal/mol)    s (Å)    Lr       La      # mie/cut
  pair_coeff	1 1     ${eps11}          3.73     12    6
  pair_coeff	2 2     ${eps22}          3.73     12    6
  pair_coeff	1 2     ${eps12}          3.73     12    6
 

#--------------------------------------------------------------------------------------------
pair_modify	tail	no

#------------------------------------ Output Settings ---------------------------------------
# Printing statistics and frequencies
#--------------------------------------------------------------------------------------------

thermo 		1000					
	thermo_style 	custom	step cpu temp press density etotal ke pe evdwl etail 
dump 	1	all 	xyz 	100000 	lammpstrj.xyz   # coordinates file XYZ every 10000 steps
restart		20000000	rst

#-------------------------------------------- Run -------------------------------------------
#--------------------------------------------------------------------------------------------


timestep	4	

variable      	TotEng  equal etotal
fix averages	all     ave/time 20 5000 100000 c_thermo_temp c_thermo_press[0] c_thermo_press[1] c_thermo_press[2] c_thermo_press[3] v_TotEng  file ave.lammps.txt      

# Select NVT simulation

fix   	TP	all	nvt	temp 	${TT} ${TT} 100 

compute lala all chunk/atom bin/1d z lower 1 units box

#calculo de los tensores
compute T all temp
compute press all stress/atom T
fix tensor1 all ave/chunk  20 125000 2500000 lala density/number c_press[1] c_press[2] c_press[3] file tensores.txt

fix tensor2 c1 ave/chunk  20 125000 2500000 lala density/number file c1.txt
fix tensor3 c2 ave/chunk  20 125000 2500000 lala density/number file c2.txt

fix 1 all recenter NULL NULL INIT
  run 25000000
unfix 	TP

#write_data	data.out
write_restart	rst.out

